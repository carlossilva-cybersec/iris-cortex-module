+#  version 3 of the License, or (at your option) any later version.
+"""Optional web extensions shipped by pip-installed IRIS modules.
+
+A package declares an entry point in the ``iris.web_extensions`` group pointing
+to a callable ``init_app(app)``. The callable may register Flask blueprints and
+append URLs to ``IRIS_WEB_EXTENSION_SCRIPTS`` / ``IRIS_WEB_EXTENSION_STYLESHEETS``,
+which the default layout includes on every page.
+
+Extensions are loaded before post-init so their SQLAlchemy models are created
+by ``db.create_all()``. A failing extension is logged and skipped: it can never
+prevent IRIS from starting. Set IRIS_DISABLED_WEB_EXTENSIONS to a comma
+separated list of entry point names to skip some of them.
+"""
+import os
+from importlib.metadata import entry_points
+
+ENTRY_POINT_GROUP = 'iris.web_extensions'
+
+
+def _iter_entry_points():
+    eps = entry_points()
+    if hasattr(eps, 'select'):
+        return eps.select(group=ENTRY_POINT_GROUP)
+    return eps.get(ENTRY_POINT_GROUP, [])
+
+
+def load_web_extensions(flask_app):
+    flask_app.config.setdefault('IRIS_WEB_EXTENSION_SCRIPTS', [])
+    flask_app.config.setdefault('IRIS_WEB_EXTENSION_STYLESHEETS', [])
+    disabled = {name.strip() for name in os.getenv('IRIS_DISABLED_WEB_EXTENSIONS', '').split(',') if name.strip()}
+
+    for entry_point in _iter_entry_points():
+        if entry_point.name in disabled:
+            flask_app.logger.info(f'Web extension {entry_point.name} disabled by configuration')
+            continue
+        try:
+            entry_point.load()(flask_app)
+            flask_app.logger.info(f'Loaded web extension {entry_point.name}')
+        except Exception:
+            flask_app.logger.exception(f'Unable to load web extension {entry_point.name}, skipping it')
+
+    @flask_app.context_processor
+    def inject_web_extensions():
+        return {
+            'iris_extension_scripts': flask_app.config['IRIS_WEB_EXTENSION_SCRIPTS'],
+            'iris_extension_stylesheets': flask_app.config['IRIS_WEB_EXTENSION_STYLESHEETS'],
+        }
