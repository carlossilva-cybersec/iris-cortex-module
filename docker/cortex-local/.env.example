# Copy to .env (never commit it).
# Host directory for Cortex job files: shared with Docker Desktop, same path inside the container, no spaces.
CORTEX_JOBS_HOST_DIR=/Users/<you>/cortex-jobs
# Play session secret: any long random string (python3 -c "import secrets;print(secrets.token_urlsafe(48))").
CORTEX_SECRET=change-me
